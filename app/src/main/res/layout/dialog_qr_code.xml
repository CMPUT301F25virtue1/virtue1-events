<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/lightBlue"
    android:padding="12dp"
    android:elevation="10dp"
    android:layout_gravity="center">

    <View
        android:id="@+id/dialog_top_bar"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:background="@color/red"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Event QR Code"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/dialog_top_bar"
        app:layout_constraintBottom_toBottomOf="@id/dialog_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/button_close_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:contentDescription="Close"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/white"
        app:layout_constraintTop_toTopOf="@id/dialog_top_bar"
        app:layout_constraintBottom_toBottomOf="@id/dialog_top_bar"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/image_qr_code"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_white"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/dialog_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="QR code image"/>

    <Button
        android:id="@+id/button_download_qr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Download"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/darkerTeal"
        app:cornerRadius="10dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/image_qr_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
