<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddEventActivity"
    android:background="@color/lightBlue">

    <View
        android:id="@+id/top_status_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/red"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/back_button_holder"
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:background="@color/red"
        app:layout_constraintTop_toBottomOf="@id/top_status_bar" />

    <ImageView
        android:id="@+id/button_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/back_button_holder"
        app:layout_constraintEnd_toEndOf="@+id/back_button_holder"
        app:layout_constraintHorizontal_bias="0.0"
        android:layout_marginBottom="5dp"
        app:layout_constraintStart_toStartOf="@+id/back_button_holder"
        app:layout_constraintTop_toTopOf="@+id/back_button_holder"
        app:srcCompat="@drawable/baseline_arrow_back_ios_24" />

    <EditText
        android:id="@+id/text_event_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/rounded_white"
        android:elevation="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:singleLine="true"
        android:hint="Event Name"
        android:textAlignment="center"
        android:textColor="@color/darkerTeal"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/back_button_holder" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Entrant Limit:"
        android:textColor="@color/darkerTeal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/text_event_name"
        app:layout_constraintTop_toBottomOf="@+id/textView9" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Event Capacity:"
        android:textColor="@color/darkerTeal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/text_event_name"
        app:layout_constraintTop_toBottomOf="@+id/text_event_name" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Geolocation Required:"
        android:textColor="@color/darkerTeal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/text_event_name"
        app:layout_constraintTop_toBottomOf="@+id/textView8" />

    <EditText
        android:id="@+id/text_event_capacity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white"
        android:hint="-"
        android:minWidth="35dp"
        android:padding="5dp"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:singleLine="true"
        android:textColor="@color/darkerTeal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textView9"
        app:layout_constraintEnd_toEndOf="@+id/text_event_name"
        app:layout_constraintTop_toTopOf="@+id/textView9" />

    <EditText
        android:id="@+id/text_entrant_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white"
        android:hint="-"
        android:singleLine="true"
        android:minWidth="35dp"
        android:padding="5dp"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColor="@color/darkerTeal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textView8"
        app:layout_constraintEnd_toEndOf="@+id/text_event_name"
        app:layout_constraintTop_toTopOf="@+id/textView8" />

    <CheckBox
        android:id="@+id/checkBox"
        android:button="@drawable/empty_check"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/rounded_dark_teal"
        android:foreground="@drawable/checkbox_icon"
        app:layout_constraintBottom_toBottomOf="@+id/textView10"
        app:layout_constraintEnd_toEndOf="@+id/text_event_name"
        app:layout_constraintTop_toTopOf="@+id/textView10" />

    <EditText
        android:id="@+id/text_event_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_white"
        android:padding="5dp"
        android:singleLine="true"
        android:hint="Event Location"
        android:textAlignment="center"
        android:textColor="@color/darkerTeal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/text_event_name"
        app:layout_constraintStart_toStartOf="@+id/text_event_name"
        app:layout_constraintTop_toBottomOf="@+id/textView10" />

    <EditText
        android:id="@+id/text_event_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_white"
        android:padding="5dp"
        android:hint="Event Time"
        android:textAlignment="center"
        android:singleLine="true"
        android:textColor="@color/darkerTeal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/text_event_name"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/text_event_name"
        app:layout_constraintTop_toBottomOf="@+id/text_event_location" />

    <TextView
        android:id="@+id/text_event_registration_period"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_white"
        android:padding="5dp"
        android:hint="Registration Period"
        android:textAlignment="center"
        android:textColor="@color/darkerTeal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/text_event_name"
        app:layout_constraintStart_toStartOf="@+id/text_event_name"
        app:layout_constraintTop_toBottomOf="@+id/text_event_time" />

    <EditText
        android:id="@+id/text_event_description"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_white"
        android:padding="5dp"
        android:hint="You have no event description."
        android:maxHeight="500dp"
        android:textAlignment="viewStart"
        android:gravity="top|start"
        android:textColor="@color/darkerTeal"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/image_event_poster"
        app:layout_constraintEnd_toEndOf="@+id/text_event_registration_period"
        app:layout_constraintStart_toStartOf="@+id/text_event_registration_period"
        app:layout_constraintTop_toBottomOf="@+id/text_event_registration_period" />

    <Button
        android:id="@+id/button_save_event_changes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/darkerTeal"
        android:padding="10dp"
        android:text="Save Changes"
        android:textSize="24sp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/text_event_description"
        app:layout_constraintStart_toStartOf="@+id/text_event_description"
        app:layout_constraintTop_toBottomOf="@id/image_event_poster"
        android:textColor="@color/white" />

    <ImageView
        android:id="@+id/image_event_poster"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_white"
        app:layout_constraintTop_toBottomOf="@id/text_event_description"
        app:layout_constraintBottom_toTopOf="@+id/button_save_event_changes"
        app:layout_constraintEnd_toEndOf="@+id/text_event_description"
        app:layout_constraintStart_toStartOf="@+id/text_event_description"
        app:srcCompat="@drawable/outline_photo_camera_24" />


</androidx.constraintlayout.widget.ConstraintLayout>